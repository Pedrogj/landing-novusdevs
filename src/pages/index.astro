---
import Layout from '../layouts/Layout.astro';
import { landingContent as content } from '../data/landingContent';

const {
	brand,
	meta,
	nav,
	hero,
	problems,
	solution,
	tailored,
	features,
	process,
	faq,
	contact,
} = content;
---

<Layout title={meta.title} description={meta.description}>
	<main class="site-shell">
		<header class="topbar" aria-label="Navegacion principal">
			<a class="brand" href="/" aria-label={`${brand.name} inicio`}>
				<span class="brand-mark">{brand.logoMark}</span>
				<span>
					<strong>{brand.name}</strong>
					<small>{brand.tagline}</small>
				</span>
			</a>

			<nav>
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>

		<section class="hero-section" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">{hero.eyebrow}</p>
				<h1 id="hero-title">{hero.title}</h1>
				<p class="hero-description">{hero.description}</p>
				<div class="hero-actions">
					<a class="button primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
					<a class="button secondary" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
				</div>
			</div>

			<div class="stats-strip" aria-label="Beneficios principales">
				{hero.stats.map((stat) => (
					<div>
						<strong>{stat.value}</strong>
						<span>{stat.label}</span>
					</div>
				))}
			</div>
		</section>

		<section class="problem-section" aria-labelledby="problem-title">
			<div>
				<p class="eyebrow">{problems.kicker}</p>
				<h2 id="problem-title">{problems.title}</h2>
			</div>
			<div class="problem-list">
				{problems.items.map((item) => (
					<p><span aria-hidden="true"></span>{item}</p>
				))}
			</div>
		</section>

		<section class="solution-section" id="servicio" aria-labelledby="solution-title">
			<div class="section-visual">
				<img src={solution.image.src} alt={solution.image.alt} loading="lazy" />
			</div>
			<div class="section-copy">
				<p class="eyebrow">{solution.kicker}</p>
				<h2 id="solution-title">{solution.title}</h2>
				<p>{solution.description}</p>
				<ul class="check-list">
					{solution.points.map((point) => <li>{point}</li>)}
				</ul>
			</div>
		</section>

		<section class="tailored-section" aria-labelledby="tailored-title">
			<div class="section-heading">
				<p class="eyebrow">{tailored.kicker}</p>
				<h2 id="tailored-title">{tailored.title}</h2>
				<p>{tailored.description}</p>
			</div>
			<div class="tailored-grid">
				{tailored.items.map((item) => (
					<article>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
			<p class="tailored-note">{tailored.note}</p>
			<div class="audience-callout">
				<h3>{tailored.audienceTitle}</h3>
				<p>{tailored.audienceDescription}</p>
			</div>
		</section>

		<section class="features-section" aria-labelledby="features-title">
			<div class="section-heading">
				<p class="eyebrow">{features.kicker}</p>
				<h2 id="features-title">{features.title}</h2>
			</div>
			<div class="feature-grid">
				{features.items.map((item) => (
					<article>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
		</section>

		<div class="dark-band">
			<section class="process-section" id="proceso" aria-labelledby="process-title">
				<div class="section-heading">
					<p class="eyebrow">{process.kicker}</p>
					<h2 id="process-title">{process.title}</h2>
				</div>
				<div class="timeline">
					{process.steps.map((step, index) => (
						<article>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<h3>{step.title}</h3>
							<p>{step.description}</p>
						</article>
					))}
				</div>
			</section>

			<section class="faq-section" id="preguntas" aria-labelledby="faq-title">
				<div class="section-heading">
					<p class="eyebrow">{faq.kicker}</p>
					<h2 id="faq-title">{faq.title}</h2>
				</div>
				<div class="faq-list">
					{faq.items.map((item) => (
						<details>
							<summary>{item.question}</summary>
							<p>{item.answer}</p>
						</details>
					))}
				</div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="eyebrow">{contact.kicker}</p>
				<h2 id="contact-title">{contact.title}</h2>
				<p>{contact.description}</p>
				<form class="contact-form" action={contact.cta.href} method="post" enctype="text/plain">
					{contact.fields.map((field) => (
						<label class:list={["form-field", field.type === "textarea" && "form-field-wide"]}>
							<span>{field.label}</span>
							{field.type === "textarea" ? (
								<textarea name={field.name} rows="4" required={field.required}></textarea>
							) : (
								<input type={field.type} name={field.name} required={field.required} />
							)}
						</label>
					))}
					<button class="button primary form-submit" type="submit">{contact.cta.label}</button>
				</form>
			</section>
		</div>
	</main>
</Layout>

<style>
	:global(body) {
		color: #13231f;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	:global(a) {
		color: inherit;
	}

	.site-shell {
		overflow: hidden;
		background:
			radial-gradient(circle at top left, rgba(245, 200, 75, 0.28), transparent 34rem),
			linear-gradient(180deg, #f7f5ef 0%, #eef6f1 100%);
	}

	.dark-band {
		background: #10201c;
	}

	.topbar {
		align-items: center;
		display: flex;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 1180px;
		padding: 26px 24px 12px;
		position: relative;
		z-index: 2;
	}

	.brand {
		align-items: center;
		display: inline-flex;
		gap: 12px;
		text-decoration: none;
	}

	.brand-mark {
		align-items: center;
		background: #10201c;
		border-radius: 8px;
		color: #99f6e4;
		display: inline-flex;
		font-weight: 900;
		height: 42px;
		justify-content: center;
		width: 42px;
	}

	.brand strong,
	.brand small {
		display: block;
	}

	.brand strong {
		font-size: 1rem;
	}

	.brand small {
		color: #5d6b66;
		font-size: 0.76rem;
		margin-top: 2px;
	}

	nav {
		align-items: center;
		display: flex;
		gap: 18px;
	}

	nav a {
		color: #465650;
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
	}

	.hero-section {
		margin: 0 auto;
		max-width: 1180px;
		min-height: 620px;
		padding: 78px 24px 54px;
		position: relative;
	}

	.hero-copy {
		margin: 0 auto;
		max-width: 1180px;
		text-align: center;
	}

	.eyebrow {
		color: #9f3f2c;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		margin: 0 0 14px;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		color: #10201c;
		font-size: clamp(3rem, 8vw, 5.8rem);
		line-height: 0.95;
		margin: 0 auto 24px;
		/* max-width: 920px; */
	}

	h2 {
		font-size: clamp(2rem, 4.5vw, 3.6rem);
		line-height: 1;
		margin-bottom: 18px;
	}

	h3 {
		font-size: 1.12rem;
		line-height: 1.2;
		margin-bottom: 12px;
	}

	p {
		color: #52615c;
		font-size: 1rem;
		line-height: 1.7;
	}

	.hero-description {
		font-size: 1.14rem;
		margin-left: auto;
		margin-right: auto;
		max-width: 620px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
		margin-top: 34px;
	}

	.button {
		align-items: center;
		border-radius: 8px;
		display: inline-flex;
		font-weight: 900;
		justify-content: center;
		min-height: 52px;
		padding: 0 22px;
		text-decoration: none;
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			background 180ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	a:focus-visible,
	summary:focus-visible {
		outline: 3px solid #164e63;
		outline-offset: 4px;
	}

	.dark-band a:focus-visible,
	.dark-band summary:focus-visible {
		outline-color: #f5c84b;
	}

	.button.primary {
		background: #10201c;
		box-shadow: 0 18px 38px rgba(16, 32, 28, 0.2);
		color: #ffffff;
	}

	.button.secondary {
		background: #ffffff;
		box-shadow: inset 0 0 0 1px rgba(16, 32, 28, 0.12);
		color: #10201c;
	}

	.section-visual img {
		display: block;
		height: auto;
		width: 100%;
	}

	.stats-strip {
		background: #ffffff;
		border: 1px solid rgba(16, 32, 28, 0.08);
		border-radius: 8px;
		box-shadow: 0 22px 70px rgba(16, 32, 28, 0.12);
		display: grid;
		gap: 1px;
		grid-template-columns: repeat(3, 1fr);
		margin-top: 64px;
		overflow: hidden;
	}

	.stats-strip div {
		background: #ffffff;
		padding: 24px;
	}

	.stats-strip strong,
	.stats-strip span {
		display: block;
	}

	.stats-strip strong {
		color: #164e63;
		font-size: 1.6rem;
		margin-bottom: 5px;
	}

	.stats-strip span {
		color: #52615c;
		line-height: 1.45;
	}

	.problem-section,
	.solution-section,
	.tailored-section,
	.features-section,
	.process-section,
	.faq-section,
	.contact-section {
		margin: 0 auto;
		max-width: 1180px;
		padding: 86px 24px;
	}

	.problem-section {
		align-items: start;
		display: grid;
		gap: 54px;
		grid-template-columns: minmax(0, 0.86fr) minmax(320px, 1fr);
	}

	.problem-section h2,
	.solution-section h2,
	.features-section h2 {
		color: #10201c;
	}

	.problem-list {
		display: grid;
		gap: 16px;
	}

	.problem-list p {
		align-items: flex-start;
		background: rgba(255, 255, 255, 0.78);
		border: 1px solid rgba(16, 32, 28, 0.08);
		border-radius: 8px;
		display: flex;
		gap: 14px;
		margin: 0;
		padding: 18px;
	}

	.problem-list span {
		background: #ef6f4e;
		border-radius: 999px;
		flex: 0 0 10px;
		height: 10px;
		margin-top: 9px;
		width: 10px;
	}

	.solution-section {
		align-items: center;
		display: grid;
		gap: 54px;
		grid-template-columns: minmax(320px, 0.9fr) minmax(0, 1fr);
	}

	.section-copy > p {
		font-size: 1.08rem;
	}

	.check-list {
		display: grid;
		gap: 14px;
		list-style: none;
		margin: 26px 0 0;
		padding: 0;
	}

	.check-list li {
		align-items: start;
		color: #1f332e;
		display: flex;
		font-weight: 750;
		gap: 12px;
		line-height: 1.45;
	}

	.check-list li::before {
		background: #99f6e4;
		border-radius: 6px;
		content: "";
		flex: 0 0 18px;
		height: 18px;
		margin-top: 2px;
	}

	.section-heading {
		margin: 0 auto 42px;
		max-width: 760px;
		text-align: center;
	}

	.section-heading > p:last-child {
		margin-left: auto;
		margin-right: auto;
		max-width: 700px;
	}

	.tailored-grid {
		display: grid;
		gap: 18px;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.tailored-grid article {
		background: #ffffff;
		border: 1px solid rgba(16, 32, 28, 0.08);
		border-radius: 8px;
		padding: 24px;
	}

	.tailored-grid article:nth-child(2),
	.tailored-grid article:nth-child(5) {
		background: #fff4d3;
	}

	.tailored-grid article:nth-child(3) {
		background: #dffcf6;
	}

	.tailored-grid h3,
	.audience-callout h3 {
		color: #10201c;
	}

	.tailored-note {
		font-weight: 700;
		margin: 26px auto 0;
		max-width: 760px;
		text-align: center;
	}

	.audience-callout {
		border-bottom: 1px solid rgba(16, 32, 28, 0.16);
		border-top: 1px solid rgba(16, 32, 28, 0.16);
		display: grid;
		gap: 28px;
		grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1.35fr);
		margin-top: 54px;
		padding: 32px 0;
	}

	.audience-callout h3,
	.audience-callout p {
		margin-bottom: 0;
	}

	.feature-grid {
		display: grid;
		gap: 18px;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.feature-grid article {
		background: #ffffff;
		border: 1px solid rgba(16, 32, 28, 0.08);
		border-radius: 8px;
		min-height: 246px;
		padding: 24px;
	}

	.feature-grid article:nth-child(2) {
		background: #fff4d3;
	}

	.feature-grid article:nth-child(3) {
		background: #dffcf6;
	}

	.feature-grid h3 {
		color: #10201c;
	}

	.process-section,
	.faq-section,
	.contact-section {
		color: #ffffff;
	}

	.process-section h2,
	.faq-section h2,
	.contact-section h2 {
		color: #ffffff;
	}

	.process-section .eyebrow,
	.faq-section .eyebrow,
	.contact-section .eyebrow {
		color: #99f6e4;
	}

	.timeline {
		display: grid;
		gap: 18px;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.timeline article {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		min-height: 260px;
		padding: 28px;
	}

	.timeline span {
		color: #f5c84b;
		display: block;
		font-size: 0.88rem;
		font-weight: 900;
		margin-bottom: 44px;
	}

	.timeline h3,
	.timeline p,
	.faq-list p,
	.contact-section p {
		color: rgba(255, 255, 255, 0.78);
	}

	.timeline h3,
	.faq-list summary {
		color: #ffffff;
	}

	.faq-list {
		display: grid;
		gap: 14px;
		margin: 0 auto;
		max-width: 880px;
	}

	details {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		padding: 0 22px;
	}

	summary {
		cursor: pointer;
		font-size: 1.04rem;
		font-weight: 900;
		list-style: none;
		padding: 22px 0;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		color: #99f6e4;
		content: "+";
		float: right;
	}

	details[open] summary::after {
		content: "-";
	}

	details p {
		margin-bottom: 22px;
	}

	.contact-section {
		padding-bottom: 120px;
		text-align: center;
	}

	.contact-section p {
		margin: 0 auto 28px;
		max-width: 680px;
	}

	.contact-section .button.primary {
		background: #99f6e4;
		border: 0;
		color: #10201c;
		cursor: pointer;
	}

	.contact-form {
		display: grid;
		gap: 18px;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin: 48px auto 0;
		max-width: 900px;
		text-align: left;
	}

	.form-field {
		display: grid;
		gap: 8px;
	}

	.form-field-wide,
	.form-submit {
		grid-column: 1 / -1;
	}

	.form-field span {
		color: #ffffff;
		font-size: 0.9rem;
		font-weight: 800;
	}

	.form-field input,
	.form-field textarea {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-radius: 8px;
		color: #ffffff;
		font: inherit;
		min-height: 52px;
		padding: 12px 14px;
		width: 100%;
	}

	.form-field textarea {
		min-height: 116px;
		resize: vertical;
	}

	.form-field input:focus,
	.form-field textarea:focus {
		border-color: #99f6e4;
		outline: 3px solid rgba(153, 246, 228, 0.22);
		outline-offset: 2px;
	}

	@media (max-width: 980px) {
		.problem-section,
		.solution-section {
			grid-template-columns: 1fr;
		}

		.hero-section {
			min-height: auto;
			padding-top: 54px;
		}

		.feature-grid,
		.tailored-grid,
		.timeline {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.topbar {
			align-items: flex-start;
			gap: 18px;
			padding-inline: 18px;
		}

		nav {
			display: none;
		}

		.hero-section,
		.problem-section,
		.solution-section,
		.tailored-section,
		.features-section,
		.process-section,
		.faq-section,
		.contact-section {
			padding-left: 18px;
			padding-right: 18px;
		}

		.hero-section {
			padding-bottom: 34px;
		}

		h1 {
			font-size: 30px;
		}

		.hero-actions {
			display: grid;
		}

		.button {
			width: 100%;
		}

		.stats-strip,
		.feature-grid,
		.tailored-grid,
		.timeline,
		.contact-form,
		.audience-callout {
			grid-template-columns: 1fr;
		}

		.stats-strip div,
		.feature-grid article,
		.tailored-grid article,
		.timeline article {
			min-height: auto;
		}

		.problem-section,
		.solution-section,
		.tailored-section,
		.features-section,
		.process-section,
		.faq-section {
			padding-bottom: 58px;
			padding-top: 58px;
		}

		.section-heading {
			text-align: left;
		}
	}
</style>
